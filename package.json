{
  "name": "reasontrace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/sources/*",
    "packages/engines/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node apps/server/src/main.ts",
    "build": "npm run build -w @reasontrace/web",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.scripts.json && npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run check:deps && npm run check:colours && npm run check:contrast && npm run check:motion && npm test && npm run build && npm run check:server",
    "test": "vitest run",
    "test:live": "RT_LIVE_TESTS=1 vitest run live --reporter=verbose",
    "check:deps": "node scripts/check-deps.mjs",
    "check:colours": "node scripts/check-colours.mjs",
    "check:server": "node apps/server/src/main.ts --version",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:motion": "node scripts/check-motion.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.0.5"
  }
}
